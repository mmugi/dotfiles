[core]
	autocrlf = input
[fetch]
	prune = true
[merge]
	ff = false
[pull]
	ff = only
[push]
	default = simple
[user]
	useConfigOnly = true
[alias]
	show-alias = config --get-regexp ^alias\\.
	d = diff
	ds = diff --staged
	l = log --graph --oneline --decorate=full
	ll = log --graph --date=iso --decorate=full --stat
	s = status --short --branch
	ss = status

# Sourced from ~/.zshrc. Keep host-specific settings in ~/.zshrc itself.

# aliases
alias ll='ls -AFhl'

# completion
if (( ! $+functions[compdef] )); then
  autoload -Uz compinit && compinit
fi

# prompt
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
else
  PROMPT='[%D{%FT%T%z}] %n@%m %~ %F{#948cf3}%#%f ' # purple #948cf3
fi

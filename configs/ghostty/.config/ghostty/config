font-size = 10
font-feature = -dlig
font-family = "HackGen Console NF Regular"
#font-family = "BigBlueTermPlus Nerd Font Mono"
#font-family = "Fusion Pixel 10px Mono ja"

#theme = aura
#theme = "Apple System Colors"
#theme = Carbonfox
#theme = Cyberdyne
#theme = Cyberpunk
#theme = CyberpunkScarletProtocol
#theme = "Electron Highlighter"
#theme = "HaX0R BLUE"
#theme = "Havn Skumring"
#theme = Heeler
#theme = Lavandula
#theme = "Nocturnal Winter"
theme = Rebecca
#theme = "Shades Of Purple"
#theme = Sugarplum

cursor-style = block
cursor-style-blink = true

background-opacity = 0.9
#background-blur = true
background-blur = macos-glass-clear

unfocused-split-opacity = 1

keybind = super+a=toggle_quick_terminal

window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

copy-on-select = true

quit-after-last-window-closed = true

quick-terminal-position = center
quick-terminal-size = 80%,80%
quick-terminal-autohide = true

shell-integration-features = no-cursor

custom-shader = shaders/cursor_sweep.glsl
custom-shader = shaders/ripple_cursor.glsl

macos-titlebar-style = tabs
macos-option-as-alt = true
